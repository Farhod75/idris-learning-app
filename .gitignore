# =============================================================================
# .gitignore — Idris Learning App
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
# NEVER commit API keys, tokens, or local env overrides
.env
.env.local
.env.*.local
.env.production
.env.staging
*.secret
secrets.json

# Supabase local secrets (generated by: supabase secrets list)
supabase/.env
supabase/functions/.env

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ── Supabase local dev ───────────────────────────────────────────────────────
supabase/.temp/
supabase/functions/node_modules/

# ── Python test dependencies ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.eggs/
htmlcov/
.coverage
coverage.xml

# Python virtual environments
.venv/
venv/
env/
ENV/

# ── Node (if ever added) ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V500
.Trashes
Thumbs.db
desktop.ini

# ── Editor & IDE ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/settings.json
.vscode/launch.json

# ── Playwright test output ───────────────────────────────────────────────────
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/node_modules/

# ── Audio/media that should not be in git ────────────────────────────────────
# Raw voice recordings (mama's voice) — use ElevenLabs, not git
assets/sounds/*.mp3
assets/sounds/*.wav
assets/sounds/*.webm
assets/sounds/*.m4a

# ── Generated / build artifacts ──────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp

.vercel

# Multi-agent generated reports (keep bug-queue.json, exclude run reports)
tests/playwright/multi-agent/reports/fix-report*.json
tests/playwright/multi-agent/reports/verify-report*.json
tests/playwright/multi-agent/reports/orchestrator-report*.json
tests/playwright/multi-agent/reports/results.json
tests/playwright/multi-agent/reports/fp-log.md
tests/playwright/multi-agent/reports/artifacts/
tests/playwright/multi-agent/reports/html/
tests/playwright/multi-agent/reports/screenshots/
tests/playwright/multi-agent/package-lock.json
tests/reports/
diag.js

.claude/settings.local.json
