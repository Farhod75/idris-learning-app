{
  "name": "idris-multi-agent-qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "fix:agent": "ts-node orchestrator-with-fixer.ts",
    "fix:local": "cross-env BASE_URL=http://localhost:3000 ts-node orchestrator-with-fixer.ts",
    "fix:prod": "cross-env BASE_URL=https://idris-learning-app.vercel.app ts-node orchestrator-with-fixer.ts",
    "test": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test",
    "test:orchestrator": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test orchestrator.spec.ts --project=ipad-safari",
    "test:en": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/en-agent.spec.ts --project=ipad-safari",
    "test:ru": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/ru-agent.spec.ts --project=ipad-safari",
    "test:uz": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/uz-agent.spec.ts --project=ipad-safari",
    "test:tg": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/tg-agent.spec.ts --project=ipad-safari",
    "test:ar": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/ar-agent.spec.ts --project=ipad-safari",
    "test:es": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/es-agent.spec.ts --project=ipad-safari",
    "test:fr": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test agents/fr-agent.spec.ts --project=ipad-safari",
    "test:iphone": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test --project=iphone-safari",
    "test:chrome": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test --project=desktop-chrome",
    "test:headed": "cross-env BASE_URL=https://idris-learning-app.vercel.app playwright test --headed --project=ipad-safari",
    "report": "playwright show-report reports/html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
